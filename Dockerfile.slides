# =====================================================================
# Reveal.js Slides Dockerfile — Vite Dev Server
# =====================================================================
FROM node:22-alpine

WORKDIR /app

# Copy dependency specifications first for layer caching
COPY package*.json ./

RUN npm install

# Copy application files
COPY . .

# Port for Vite dev server (Reveal.js)
EXPOSE 8000

# Start Vite dev server accessible externally
CMD ["npm", "start", "--", "--host", "0.0.0.0", "--port", "8000"]
